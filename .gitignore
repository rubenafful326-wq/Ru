        </div>

    </div>

</section>



<!-- =========================
     ABOUT
========================== -->

<section class="section dark-section" id="about">

    <div class="about">

        <div class="section-title">

            <span>ABOUT THE DJ</span>

            <h2>DJ LUCXY</h2>

        </div>


        <p>

            Welcome to the official home of DJ LUCXY.

            Discover the latest songs, exclusive mixes
            and new mixtapes. Listen online and download
            your favourite music.

        </p>


        <div class="social">

            <!-- Replace these with your real pages -->

            <a href="#" target="_blank">
                Instagram
            </a>

            <a href="#" target="_blank">
                TikTok
            </a>

            <a href="#" target="_blank">
                YouTube
            </a>

            <a href="#" target="_blank">
                Facebook
            </a>

        </div>

    </div>

</section>



<!-- =========================
     FOOTER
========================== -->

<footer>

    <p>
        © 2026 <strong>DJ LUCXY</strong>.
        All Rights Reserved.
    </p>

    <p style="margin-top:10px;">
        Music • Mixtapes • Entertainment
    </p>

</footer>



<!-- =========================
     JAVASCRIPT
========================== -->

<script>

    /* MOBILE MENU */

    function toggleMenu() {

        const nav = document.getElementById("nav");

        nav.classList.toggle("active");

    }


    function closeMenu() {

        const nav = document.getElementById("nav");

        nav.classList.remove("active");

    }


    /* STOP MULTIPLE SONGS PLAYING */

    const players = document.querySelectorAll("audio");

    players.forEach(player => {

        player.addEventListener("play", () => {

            players.forEach(otherPlayer => {

                if (otherPlayer !== player) {

                    otherPlayer.pause();

                }

            });

        });

    });


</script>


</body>
</html>
