        </div>



        <!-- SONG 2 -->

        <div class="song">

            <div class="song-number">
                02
            </div>

            <div>

                <h4>
                    Another Banger
                </h4>

                <p>
                    DJ LUCXY
                </p>

                <audio controls>

                    <source
                        src="music/song-2.mp3"
                        type="audio/mpeg">

                </audio>

            </div>

            <a
                class="song-download"
                href="music/song-2.mp3"
                download="DJ-LUCXY-Song-2.mp3">

                DOWNLOAD

            </a>

        </div>



        <!-- SONG 3 -->

        <div class="song">

            <div class="song-number">
                03
            </div>

            <div>

                <h4>
                    Latest Vibes
                </h4>

                <p>
                    DJ LUCXY
                </p>

                <audio controls>

                    <source
                        src="music/song-3.mp3"
                        type="audio/mpeg">

